{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "remote-access",
  "description": "Allow IPC from localhost dev server and live Vercel deployment",
  "local": true,
  "remote": {
    "urls": [
      "http://localhost:3000/**",
      "https://maina-offical.vercel.app/**"
    ]
  },
  "windows": ["main"],
  "permissions": [
    "core:default"
  ]
}
